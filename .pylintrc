[MAIN]
py-version = 3.12

[MESSAGES CONTROL]
disable =
    too-few-public-methods,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-ancestors,
    duplicate-code,
    import-error,
    protected-access,
    broad-exception-caught,
    unnecessary-comprehension

[TYPECHECK]
generated-members = pygame.*

[FORMAT]
max-line-length = 100
